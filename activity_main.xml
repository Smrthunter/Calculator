<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── Display area ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/displayArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.40">

        <!-- history ghost -->
        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_expr"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:layout_marginBottom="2dp"/>

        <!-- expression line -->
        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:layout_marginBottom="4dp"/>

        <!-- main result -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="72sp"
            android:textStyle="normal"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text_primary"
            android:gravity="end"
            android:maxLines="1"
            android:adjustViewBounds="true"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeMaxTextSize="72sp"/>

        <!-- active operator indicator -->
        <TextView
            android:id="@+id/tvOpIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/accent"
            android:gravity="end"
            android:letterSpacing="0.1"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- ── Thin divider ──────────────────────────────── -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/keypad"
        app:layout_constraintTop_toBottomOf="@id/displayArea"/>

    <!-- ── Keypad ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp"
        android:paddingTop="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Scientific row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:weightSum="3">
            <Button android:id="@+id/btnSqrt"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_sqrt"
                android:textSize="14sp" android:textColor="@color/text_fn"
                android:background="@drawable/bg_btn_fn"
                android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnSq"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_sq"
                android:textSize="14sp" android:textColor="@color/text_fn"
                android:background="@drawable/bg_btn_fn"
                android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnPct"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_pct"
                android:textSize="14sp" android:textColor="@color/text_fn"
                android:background="@drawable/bg_btn_fn"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Row 1: AC  +/-  .  ÷ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
            android:orientation="horizontal" android:layout_marginBottom="8dp" android:weightSum="4">
            <Button android:id="@+id/btnClear"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_clear"
                android:textSize="16sp" android:textStyle="bold" android:textColor="@color/accent"
                android:background="@drawable/bg_btn_clear"
                android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnNeg"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_neg"
                android:textSize="15sp" android:textColor="@color/text_fn"
                android:background="@drawable/bg_btn_fn"
                android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnDot"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_dot"
                android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_fn"
                android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnDiv"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_div"
                android:textSize="22sp" android:textColor="@color/white"
                android:background="@drawable/bg_btn_op"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Row 2: 7 8 9 × -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
            android:orientation="horizontal" android:layout_marginBottom="8dp" android:weightSum="4">
            <Button android:id="@+id/btn7"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_7" android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_num" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn8"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_8" android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_num" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn9"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_9" android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_num" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnMul"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_mul" android:textSize="22sp" android:textColor="@color/white"
                android:background="@drawable/bg_btn_op" android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Row 3: 4 5 6 − -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
            android:orientation="horizontal" android:layout_marginBottom="8dp" android:weightSum="4">
            <Button android:id="@+id/btn4"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_4" android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_num" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn5"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_5" android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_num" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn6"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_6" android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_num" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnSub"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_sub" android:textSize="26sp" android:textColor="@color/white"
                android:background="@drawable/bg_btn_op" android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Row 4: 1 2 3 + -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
            android:orientation="horizontal" android:layout_marginBottom="8dp" android:weightSum="4">
            <Button android:id="@+id/btn1"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_1" android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_num" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn2"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_2" android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_num" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn3"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_3" android:textSize="22sp" android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_num" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnAdd"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_add" android:textSize="26sp" android:textColor="@color/white"
                android:background="@drawable/bg_btn_op" android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Row 5: 0 (wide)  ⌫  = -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
            android:orientation="horizontal" android:weightSum="4">
            <Button android:id="@+id/btn0"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="2" android:layout_marginEnd="7dp"
                android:text="@string/btn_0" android:textSize="22sp" android:textColor="@color/text_primary"
                android:gravity="center_vertical|start" android:paddingStart="26dp"
                android:background="@drawable/bg_btn_zero" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnBack"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="7dp"
                android:text="@string/btn_back" android:textSize="20sp" android:textColor="@color/text_fn"
                android:background="@drawable/bg_btn_fn" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnEq"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_eq" android:textSize="26sp" android:textColor="@color/white"
                android:background="@drawable/bg_btn_op" android:stateListAnimator="@null"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
